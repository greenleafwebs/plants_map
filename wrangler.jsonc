{
  "name": "plants-map",
  "main": "./worker.js",
  "compatibility_date": "2026-09-02",

  "rules": [
    {
      "type": "ESModule",
      "globs": ["worker.js"]
    }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plants-map-db",
      "database_id": "83789139-e6ec-4e6a-9d92-03b6947f89c3"
    }
  ]
}
